{
  "name": "@example-origin/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Origin attestation issuer + pre-execution verifiers for bridge approvals and LST/LRT collateral",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "demo": "tsx src/demo/run.ts",
    "demo:bridge": "tsx src/demo/run.ts --scenario=bridge",
    "demo:collateral": "tsx src/demo/run.ts --scenario=collateral"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
