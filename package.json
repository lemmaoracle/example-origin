{
  "name": "example-origin",
  "type": "module",
  "private": true,
  "description": "Lemma PoC: pre-execution ZK origin proofs for DeFi bridge approvals and LST/LRT collateral",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "demo:bridge": "pnpm --filter @example-origin/core demo:bridge",
    "demo:collateral": "pnpm --filter @example-origin/core demo:collateral",
    "demo": "pnpm --filter @example-origin/core demo",
    "circuits:inputs": "pnpm --filter @example-origin/circuits circuits:inputs",
    "circuits:check": "pnpm --filter @example-origin/circuits circuits:check",
    "presets:dry-run": "tsx scripts/register-presets.ts",
    "presets:execute": "tsx scripts/register-presets.ts --execute",
    "format": "prettier --write ."
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@lemmaoracle/sdk": "^0.0.18",
    "@lemmaoracle/spec": "^0.0.18",
    "zod": "^3.23.0"
  }
}
