# example-origin — minimal PoC
# Copy this file to .env to override defaults. The demo runs without any env vars.

# Issuer DID used to sign mock origin attestations (default: did:lemma:demo-issuer)
ISSUER_DID=did:lemma:demo-issuer

# Demo mode for the verifiers
# - strict: revocation/expiry violations cause demo to exit non-zero
# - lenient: violations are reported but the demo continues
DEMO_MODE=strict

# Optional: path to bridge approval fixtures (defaults to data/bridge-approvals.json)
BRIDGE_FIXTURE_PATH=

# Optional: path to LST/LRT collateral fixtures (defaults to data/lst-collateral.json)
COLLATERAL_FIXTURE_PATH=
