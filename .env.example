# example-origin — minimal PoC
# Copy this file to .env to override defaults. The demo runs without any env vars.

# Issuer DID used to sign mock origin attestations (default: did:lemma:demo-issuer)
ISSUER_DID=did:lemma:demo-issuer

# Demo mode for the verifiers
# - strict: revocation/expiry violations cause demo to exit non-zero
# - lenient: violations are reported but the demo continues
DEMO_MODE=strict

# Optional: path to bridge approval fixtures (defaults to data/bridge-approvals.json)
BRIDGE_FIXTURE_PATH=

# Optional: path to LST/LRT collateral fixtures (defaults to data/lst-collateral.json)
COLLATERAL_FIXTURE_PATH=

# ── Lemma preset registration (scripts/register-presets.ts) ─────────────
# Defaults are dry-run friendly; only LEMMA_API_KEY is required to actually POST.

# Lemma API base URL (default: https://workers.lemma.workers.dev)
LEMMA_API_BASE_URL=

# API key — required when running with --execute
LEMMA_API_KEY=

# ── Preset manifest generation (scripts/generate-manifests.ts) ──────────
# Base URL where circuit artifacts will be hosted.
# Default: file:// path to packages/circuits/build (local dev only).
# For production deployment, set to your CDN or IPFS gateway, e.g.:
#   https://cdn.example.com/circuits/
#   ipfs://Qm.../
ARTIFACT_BASE_URL=
